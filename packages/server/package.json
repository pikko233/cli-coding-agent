{
  "name": "@cli-coding-agent/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "postinstall": "bun run --cwd ../database db:generate"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.24",
    "@ai-sdk/openai": "^4.0.24",
    "@cli-coding-agent/database": "workspace:*",
    "@cli-coding-agent/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "@sentry/bun": "^10.69.0",
    "@sentry/hono": "^10.69.0",
    "ai": "^7.0.42",
    "dotenv": "^17.4.2",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  }
}
